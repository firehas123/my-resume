# Endpoint of the external form service the contact form posts to,
# for example https://formspree.io/f/xxxxxxxx  (see README.md).
# Leave empty and the form shows a "not connected yet" notice instead of sending.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: the public address of the site, used for link previews and the sitemap.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Visit counter database (Upstash Redis). Vercel's Redis integration sets the
# KV_REST_API_* pair automatically when the database is connected to the
# project; UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
# Without them the site runs normally and the counter does nothing.
# Copy them locally with: npx vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local testing only, NEVER set this on Vercel: lets the visit counter run
# outside the production deployment.
# STATS_TEST_MODE=1
