# Contact form, server check (see README, "Contact form"). With all four set,
# the form posts to /api/contact, which verifies the hCaptcha answer and sends
# the email through Resend. Without them, it uses Web3Forms.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on your own verified Resend domain.
# CONTACT_FROM_EMAIL=Resume website <hello@example.com>

# Optional: Web3Forms access key (only used without the server check). The
# default key is in src/data/profile.json ("contactAccessKey").
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: the public address of the site, used for link previews and the sitemap.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Visit counter database (Upstash Redis). Vercel's Redis integration sets the
# KV_REST_API_* pair automatically when the database is connected to the
# project; UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
# Without them the site runs normally and the counter does nothing.
# Copy them locally with: npx vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local testing only, NEVER set this on Vercel: lets the visit counter run
# outside the production deployment.
# STATS_TEST_MODE=1
